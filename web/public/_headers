# Cloudflare Workers Assets response headers.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# /assets/share.js is referenced by the Worker at a stable URL (see
# vite.config.ts), so it must be revalidated on every load. Without this it
# would be served with long-lived caching and a browser could run stale share
# page JS for days after a deploy.
#
# All other /assets/* files are content-hashed by Vite and therefore safe to
# cache aggressively; that is the default behaviour, so they need no rule.

/assets/share.js
  Cache-Control: no-cache

# The SPA shell must also never be cached, otherwise a deploy can leave clients
# pointing at a previous build's hashed bundle names.
/
  Cache-Control: no-cache
/dashboard
  Cache-Control: no-cache
/dashboard/*
  Cache-Control: no-cache
