# Teleport backend — example production environment file.
#
# Deploy to /data/services/teleport/teleport.env with mode 0600.
# Values are read literally by systemd (no shell expansion), so the `$`
# separators inside ADMIN_PASSWORD_HASH need no escaping.

# --- Required secrets --------------------------------------------------------
# The first three are REQUIRED: the service refuses to start without them, rather
# than failing later on a request.

# Break-glass / root key. Agents no longer need this: they apply for their own
# key at POST /api/agent-keys/applications and a human approves it in the
# dashboard. This value keeps working and grants unrestricted access — including
# to every report regardless of owner — so treat it as an operator credential
# and hand it out to nobody.
# Generate: openssl rand -base64 32
AGENT_SECRET_KEY=REPLACE_ME

# HMAC key that signs the dashboard session cookie.
# Generate: openssl rand -base64 48
SESSION_SECRET=REPLACE_ME

# PBKDF2-SHA256 hash of the dashboard password.
# Generate: ./teleport hash-password 'your password'
ADMIN_PASSWORD_HASH=REPLACE_ME

# --- Network -----------------------------------------------------------------
# Bind the docker bridge gateway only: Caddy reaches the host through it, and
# the port is never exposed publicly. Do NOT bind 0.0.0.0.
LISTEN_ADDR=172.17.0.1:8788

# Path prefix Caddy routes to this service. It is part of every route, every
# share link, the SPA's asset URLs and the share page's script reference, so it
# MUST match the Caddyfile handler exactly.
#
# P6 (2026-10-16 裁决, .ai/decisions/2026-10-16-p6-single-root-entry.md): the
# service moves to the ROOT of its own hostname. The old /yeciorez/teleport
# prefix is DROPPED (a deliberate break change: even expires_at=0 permanent
# links stop working).
#
# ⚠️ Write "/" — NOT an empty value. An empty value is treated as "unset" by the
# env reader (it returns the default, which is still /yeciorez/teleport), so
# `ROUTE_PREFIX=` silently deploys the OLD prefix. "/" is what normalizePrefix
# maps to no-prefix. Measured, ROUTE_PREFIX values vs the logged prefix:
#   ""  -> /yeciorez/teleport   (the trap)
#   "/" -> ""                   (what you want)
#
# ⚠️ This value and the frontend's build-time prefix are a PAIR: the SPA's asset
# base is baked in by Vite (`base = VITE_ROUTE_PREFIX + "/"` in vite.config.ts),
# so the release build must be made with VITE_ROUTE_PREFIX=/ whenever this is
# the root path. Mismatching them gives a white page / 404 assets.
ROUTE_PREFIX="/"

# Public ORIGIN only — scheme and host, no path. The app is served under
# ROUTE_PREFIX, and AppBaseURL (= this value + ROUTE_PREFIX) is what share
# links are built from. Writing a path here would produce links with it doubled.
PUBLIC_BASE_URL=https://teleport.hcyj.xyz

# Where the share page's JS bundle is served from. Defaults to AppBaseURL.
# Override only for a split-origin deployment (page and assets on different
# hosts); doing so makes `script-src 'self'` on the share page stop covering
# the bundle, so it is deliberately not the default.
# ASSET_BASE_URL=

# Directory of a frontend build to serve from disk, as an alternative to the
# copy embedded in this binary. Useful for shipping a frontend-only change
# without recompiling. Leave unset in production: the embedded copy cannot
# drift from the running code.
# STATIC_DIR=/data/services/teleport/dist

# --- Storage -----------------------------------------------------------------
# PostgreSQL DSN. REQUIRED since the store moved from SQLite to pgx (rewrite stage
# P2.3): Load() refuses to start without it, rather than defaulting to a database
# nobody meant to write to.
#
# The password lives in this file, so it is 0600 root:root and is never committed.
# The PostgreSQL instance is shared with clip / registry / serenique, whose
# max_connections of 100 is a budget for all of them together — hence the
# explicit pool bound rather than the driver's default.
DATABASE_URL=postgres://teleport:CHANGE_ME@127.0.0.1:5432/teleport?sslmode=disable
DB_MAX_CONNS=8

# --- Behaviour ---------------------------------------------------------------
ENVIRONMENT=production

# 7 days; 0 would mean "never expires" for a link created without an explicit
# autoShareHours.
DEFAULT_SHARE_HOURS=168

# 1 MiB of report content.
MAX_CONTENT_BYTES=1048576

# Session lifetime.
SESSION_TTL=12h

# MUST stay true in production: the public entry point is HTTPS, and a
# non-Secure session cookie could be sent over plain HTTP.
COOKIE_SECURE=true

# Scope of the session cookie. Defaults to ROUTE_PREFIX, which is required on a
# SHARED public host: api.hcyj.xyz also fronts an unrelated service, and a `/`
# path would send our session cookie to it on every request. Only set this if
# you know the host is exclusively yours.
# COOKIE_PATH=/yeciorez/teleport

# Browser origins allowed to call the API cross-origin. This deployment is
# same-origin (SPA, API and share pages share one prefix), so this only affects
# a deliberately cross-origin client. Never set it to a wildcard.
FRONTEND_ORIGINS=https://teleport.hcyj.xyz

# --- Agent self-service keys -------------------------------------------------
#
# POST /api/agent-keys/applications is PUBLIC — there is no shared secret an
# agent could present, because the whole point is that it does not have one yet.
# These limits are therefore what protects the approval queue, and they are the
# reason a hostile actor cannot simply flood it.

# Applications accepted per source IP per hour. The limiter counts in memory, so
# it resets when the process restarts — acceptable for a single-binary
# deployment, and noted here so it is not mistaken for a durable quota.
KEY_APPLY_PER_HOUR=5

# How long an unapproved application stays open before it lapses. An agent that
# waits longer than this must apply again.
KEY_APPLICATION_TTL=24h

# How long an APPROVED application may still be claimed. Short on purpose: the
# credential exists only in the claim response, and this bounds how long an
# approved-but-unclaimed slot is held. Past it, no key is ever issued.
KEY_CLAIM_WINDOW=30m

# Ceiling on outstanding applications, approved or not.
KEY_MAX_PENDING=50

# Ceiling on live credentials, so a runaway agent (or a compromised approver)
# cannot mint keys without bound.
KEY_MAX_ACTIVE=100

# --- Abuse controls (rate limiting, IP blocking, dashboard CSP) ---------------
#
# What this protects: the public key-application endpoint, the dashboard login
# (one password guards everything, and each attempt costs a 600k-iteration PBKDF2
# verification), the anonymous read surface (share pages, the AI guide) and the
# write API. Refusals are the usual JSON envelope with HTTP 429 and a
# `Retry-After` header. A blocked address gets 403 with code `ip_blocked`.
#
# State is in-process: a restart clears every window and every temporary ban.
# Accepted for a single self-contained binary — an attacker cannot restart the
# process, so a burst is still bounded.
#
# ⚠️ Defaults to true when ENVIRONMENT=production and false otherwise. That is
# deliberate: the contract/browser harnesses drive ~90 requests from one address
# in seconds, and a working limiter there would read as a regression.
# SECURITY_MIDDLEWARE accepts an explicit true/false to override either way.
#
# SECURITY_MIDDLEWARE=true

# Login attempts per source address per HOUR. The tightest limit here, and the
# one worth tuning first: 10 is generous for a human who mistypes, tight for a
# brute-force. Refusing before the handler runs is the point — no PBKDF2 cost.
LOGIN_RATE_LIMIT=10

# Anonymous reads per source address per MINUTE. Only the documents are counted
# (share page, framed html body, share JSON, the AI guide); hashed bundles and
# fonts are not. Keep this comfortably above a real browsing session.
PUBLIC_READ_RATE_LIMIT=240

# Authenticated writes per source address per MINUTE. Bounds a runaway agent
# loop; a human never comes close.
WRITE_RATE_LIMIT=300

# ALL requests per SECOND, shared by every source address (one constant bucket
# key, NOT per IP). Per-IP limits cannot bound a caller with many addresses (one
# IPv6 /64 holds 2^64), so this is the backstop that makes the total cost to the
# process bounded. Keep it far above real traffic.
#
# Two properties of this bucket are deliberate and should not be "fixed":
#   - It never adds to the ban list. A global breach means the process is
#     saturated, not that the caller who happened to arrive is abusive; banning
#     them would punish legitimate readers during a flood.
#   - /api/health is exempt by exact path. A liveness probe answering 429 reads as
#     "down" to whatever polls it, and a supervisor restart would clear every
#     window and ban (the state is in-process).
GLOBAL_RATE_LIMIT=200

# Rate-limit refusals within BAN_STRIKE_TTL that escalate an address to a
# temporary block. 0 disables automatic banning and keeps only BLOCKED_IPS.
BAN_AFTER_REFUSALS=20
BAN_STRIKE_TTL=10m

# How long an automatic block lasts. It expires on its own, on purpose: a shared
# egress address (a university, a mobile carrier NAT) must not be locked out
# forever because one device behind it misbehaved.
#
# ⚠️ Banning is never applied to a trusted-proxy or loopback address. If the
# deployment ever loses X-Forwarded-For, every client collapses onto Caddy's own
# address; banning that would take the whole service down in one request. Rate
# limiting still applies there, and the process logs a loud warning.
BAN_TTL=30m

# Permanent blocklist: an address or a CIDR (comma-separated). A bare address is
# treated as /32 or /128. NEVER expires — the one control here that is not
# self-healing, so use it for a confirmed repeat offender.
#
# A value that is not an address or CIDR refuses to start, rather than becoming a
# blocklist that silently blocks nothing.
# BLOCKED_IPS=203.0.113.7,198.51.100.0/24

# The dashboard (SPA) CSP, sent as Content-Security-Policy-Report-Only unless
# DASHBOARD_CSP_ENFORCE=true.
#
# It starts report-only on purpose: a CSP that is wrong in the enforcing
# direction breaks the panel with no actionable error, while the same mistake in
# report-only mode produces a console violation and a working page. Flip this to
# true only after a real browser run shows zero reported violations. The policy
# expects no inline styles and no inline script — keep it that way.
DASHBOARD_CSP_ENFORCE=false
