# dependencies
node_modules/

# build output
dist/
.wrangler/
.output/

# Cross-compiled Go binaries (`pnpm run backend:build`). ~20 MB each and
# reproducible from source, so they never belong in git.
/bin/

# SQLite database created by a local backend run.
/backend/data/
*.db
*.db-wal
*.db-shm

# Frontend build, emitted into the //go:embed source directory. Regenerated by
# `pnpm run build` (and by `pnpm run build:release`, which also compiles it into
# the binary). Committing it would add ~5 MB — mostly Mermaid's lazy chunks —
# of noise that changes on every build, and it would make the embed pattern
# depend on checked-in artifacts.
/backend/internal/webui/dist/

# Legacy Cloudflare Workers Assets output. No longer produced (the frontend is
# embedded in the Go binary now), but kept ignored so a stale tree from an
# older checkout cannot be committed by accident.
# NOTE: the leading slash anchors to the repo root. A bare `public/` would also
# match `web/public/`, which is real source.
/public/

# local secrets — never commit
.dev.vars
.env
.env.*
!.env.example

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# npm lockfiles are not used (pnpm only)
package-lock.json
npm-shrinkwrap.json
yarn.lock
