# dependencies
node_modules/

# build output
dist/
.wrangler/
.output/

# Workers Assets build output — regenerated by `pnpm run build` before deploy.
# Committing it would add ~5 MB (mostly Mermaid's lazy chunks) of noise that
# changes on every build.
# NOTE: leading slash anchors to the repo root. A bare `public/` would also
# match `web/public/`, which is real source (it holds _headers).
/public/

# local secrets — never commit
.dev.vars
.env
.env.*
!.env.example

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# npm lockfiles are not used (pnpm only)
package-lock.json
npm-shrinkwrap.json
yarn.lock
